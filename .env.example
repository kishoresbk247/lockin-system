# Backend configuration. Never ship SUPABASE_SERVICE_ROLE_KEY in the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000

# Public HTTPS URL of the deployed Express API, used by the Capacitor app.
# Example: https://lockin-api.example.com
PUBLIC_API_URL=https://your-api.example.com
